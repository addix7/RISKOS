  "components": {
    "schemas": {
      "CounterfactualOption": {
        "properties": {
          "action": {
            "type": "string",
            "title": "Action"
          },
          "estimated_fraud_loss_paise": {
            "type": "integer",
            "title": "Estimated Fraud Loss Paise"
          },
          "estimated_fraud_loss_inr": {
            "type": "number",
            "title": "Estimated Fraud Loss Inr"
          },
          "friction_cost_paise": {
            "type": "integer",
            "title": "Friction Cost Paise"
          },
          "friction_cost_inr": {
            "type": "number",
            "title": "Friction Cost Inr"
          },
          "net_expected_value_paise": {
            "type": "integer",
            "title": "Net Expected Value Paise"
          },
          "recommended": {
            "type": "boolean",
            "title": "Recommended"
          }
        },
        "type": "object",
        "required": [
          "action",
          "estimated_fraud_loss_paise",
          "estimated_fraud_loss_inr",
          "friction_cost_paise",
          "friction_cost_inr",
          "net_expected_value_paise",
          "recommended"
        ],
        "title": "CounterfactualOption"
      },
      "CounterfactualResponse": {
        "properties": {
          "transaction_id": {
            "type": "string",
            "title": "Transaction Id"
          },
          "risk_score": {
            "type": "number",
            "title": "Risk Score"
          },
          "options": {
            "items": {
              "$ref": "#/components/schemas/CounterfactualOption"
            },
            "type": "array",
            "title": "Options"
          },
          "recommended_action": {
            "type": "string",
            "title": "Recommended Action"
          }
        },
        "type": "object",
        "required": [
          "transaction_id",
          "risk_score",
          "options",
          "recommended_action"
        ],
        "title": "CounterfactualResponse"
      },
      "DashboardSummary": {
        "properties": {
          "total_transactions": {
            "type": "integer",
            "title": "Total Transactions"
          },
          "high_risk_count": {
            "type": "integer",
            "title": "High Risk Count"
          },
          "loss_prevented_paise": {
            "type": "integer",
            "title": "Loss Prevented Paise"
          },
          "loss_prevented_inr": {
            "type": "number",
            "title": "Loss Prevented Inr"
          },
          "live_activity": {
            "items": {
              "$ref": "#/components/schemas/LiveActivityItem"
            },
            "type": "array",
            "title": "Live Activity"
          }
        },
        "type": "object",
        "required": [
          "total_transactions",
          "high_risk_count",
          "loss_prevented_paise",
          "loss_prevented_inr",
          "live_activity"
        ],
        "title": "DashboardSummary"
      },
      "DecisionResponse": {
        "properties": {
          "transaction_id": {
            "type": "string",
            "title": "Transaction Id"
          },
          "risk_score": {
            "type": "number",
            "title": "Risk Score"
          },
          "risk_band": {
            "type": "string",
            "title": "Risk Band"
          },
          "final_action": {
            "type": "string",
            "title": "Final Action"
          },
          "reasoning": {
            "type": "string",
            "title": "Reasoning"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          }
        },
        "type": "object",
        "required": [
          "transaction_id",
          "risk_score",
          "risk_band",
          "final_action",
          "reasoning",
          "confidence"
        ],
        "title": "DecisionResponse"
      },
      "FinalAction": {
        "type": "string",
        "enum": [
          "allow",
          "verify",
          "hold",
          "block"
        ],
        "title": "FinalAction"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
